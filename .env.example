# ---------------------------------------------------------------------------
# Local development database (docker-compose.yml) — REAL, WORKING values.
#
# This Postgres runs only on your own machine (started by `npm run db:setup`)
# and never holds real venue data, so its credentials are fixed and committed.
# Nothing in this file needs editing to get a working dev environment:
# `npm run db:setup` copies this file to `.env` if you don't have one yet.
#
# Per-branch schemas are derived automatically by scripts/with-branch-schema.mjs
# (every npm script that touches the DB goes through it) — leave `schema=public`
# here; it is rewritten to `dev_<branch>` at run time.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://dev:dev@localhost:5432/shiftsync_dev?schema=public"

# Only if 5432 is already taken on this machine: choose another host port for
# the container AND change the port in DATABASE_URL above to match.
# POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Optional — everything below is off / defaulted while left commented out.
# ---------------------------------------------------------------------------

# Required for image/screenshot/scanned-PDF roster ingestion
# (server/src/parsing/parseVision.ts). Leave unset to disable the image-upload
# path — Excel/CSV/PDF-text ingestion still works without it. Get your OWN key
# per worktree (free tier is 20 requests/day per key — see AGENTS.md §6).
# GEMINI_API_KEY=""
# Defaults to "gemini-3.6-flash" if unset. Must be a vision-capable Gemini model.
# VLM_MODEL="gemini-3.6-flash"
# Alternate model used when the primary returns a transient 503 ("high
# demand"). Defaults to "gemini-3.5-flash-lite" if unset.
# VLM_FALLBACK_MODEL="gemini-3.5-flash-lite"

# Vision-parser fallback behavior when the live Gemini API is unavailable
# (429 rate-limit/quota, 503 overload, or no API key).
#   "auto"   (default) — try Gemini, fall back to a cached sample response
#   "sample"           — always use the cached sample (skip the network)
#   "off"              — never fall back; surface the Gemini error
# VLM_FALLBACK_MODE="auto"

# Path to the upload-batch cache file (server/src/store/uploadCache.ts).
# Batches are persisted here so previews survive server restarts / hot-reloads.
# Defaults to "<server>/.upload-cache.json" if unset.
# UPLOAD_CACHE_FILE=""

# Web Push (VAPID) — generate your own pair with `npx web-push generate-vapid-keys`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com

# Dev-only, fail-closed flags (see server/src/routes/signup.ts and
# server/src/lib/identity.ts). playwright.config.ts sets the first two itself.
# ALLOW_DEV_OTP_ECHO=true
# ALLOW_DEV_ERROR_INJECTION=true
# ALLOW_DEV_OTP_BYPASS=true

# ---------------------------------------------------------------------------
# More optional settings. Every variable, its default and what production
# needs: docs/ENV_VARS.md
# ---------------------------------------------------------------------------

# With ALLOW_DEV_OTP_ECHO=true, ONLY the numbers listed here get their code
# echoed back (comma-separated, any format the app accepts). Every other
# number gets a code it can never see. Empty = nobody. In production, echo on
# with no valid number here makes the API refuse to boot.
# playwright.config.ts sets its own list for e2e runs.
# ECHO_ALLOWED_PHONES=

# Frontend origins that invite and login links are minted for
# (comma-separated; login links use the first). Defaults to
# http://localhost:5173 if unset.
# FRONTEND_ORIGIN=http://localhost:5173

# API port. Defaults to 4000, which is where Vite proxies /api.
# PORT=4000

# Sign-in methods: leave unset (phone codes AND login links both on).
# "links" turns the phone-code routes off.
# LOGIN_METHODS=

# How many hours a login link stays redeemable. Defaults to 24.
# LOGIN_LINK_TTL_HOURS=24

# Voice model (needs GEMINI_API_KEY). Defaults to "gemini-3.6-flash".
# VOICE_MODEL="gemini-3.6-flash"
# Timeout for roster-vision Gemini calls, in ms. Defaults to 30000.
# GEMINI_HTTP_TIMEOUT_MS=30000

# Vertex AI for roster vision instead of the Gemini Developer API. See
# docs/gcp-vertex-setup.md. The location defaults to europe-west4.
# GEMINI_VERTEX_PROJECT=
# GEMINI_VERTEX_LOCATION=europe-west4
# GOOGLE_APPLICATION_CREDENTIALS=

# Optional Docling sidecar (npm run docling:sidecar), and the Python that
# rasterizes PDF floor plans (defaults to the sidecar's Windows venv).
# DOCLING_SIDECAR_HOST=http://127.0.0.1:8901
# DOCLING_TIMEOUT_MS=90000
# DOCLING_PYTHON_PATH=

# Leave NODE_ENV unset locally. "production" turns off the per-branch-schema
# fallback in server/src/lib/prisma.ts and arms the production boot checks.
