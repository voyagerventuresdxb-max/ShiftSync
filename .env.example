DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/shiftsync?schema=public"

# Required for image/screenshot/scanned-PDF roster ingestion (server/src/parsing/parseVision.ts).
# Leave unset to disable the image-upload path — Excel/CSV/PDF-text ingestion still works without it.
GEMINI_API_KEY="<GEMINI_API_KEY>"
# Optional — defaults to "gemini-3.6-flash" if unset. Must be a vision-capable Gemini model.
VLM_MODEL="gemini-3.6-flash"
# Optional — alternate model used when the primary returns a transient 503
# ("high demand"). Defaults to "gemini-3.5-flash-lite" if unset.
VLM_FALLBACK_MODEL="gemini-3.5-flash-lite"

# Optional — vision-parser fallback behavior when the live Gemini API is
# unavailable (429 rate-limit/quota, 503 overload, or no API key).
#   "auto"   (default) — try Gemini, fall back to a cached sample response
#   "sample"           — always use the cached sample (skip the network)
#   "off"              — never fall back; surface the Gemini error
VLM_FALLBACK_MODE="auto"

# Optional — path to the upload-batch cache file (server/src/store/uploadCache.ts).
# Batches are persisted here so previews survive server restarts / hot-reloads.
# Defaults to "<server>/.upload-cache.json" if unset.
UPLOAD_CACHE_FILE="<path-to-upload-cache.json>"

# Web Push (VAPID) — generate your own pair with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
