<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older (fullBackupContent). Nothing in this app may be copied
     by Auto Backup: the WebView's storage holds the signed-in session, and a
     restored backup must never carry a session onto another device. Together
     with android:allowBackup="false" this is belt and braces. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
