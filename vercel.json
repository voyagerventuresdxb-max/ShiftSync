{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://RAILWAY_API_HOST/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://RAILWAY_API_HOST/uploads/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
