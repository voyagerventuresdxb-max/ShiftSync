{
  "name": "shiftsync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n api,web -c blue,green \"npm:server:dev\" \"npm:dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/engine/*.test.ts \"src/components/**/*.test.ts\" \"src/features/**/*.test.ts\" \"src/state/**/*.test.ts\"",
    "test:server": "node scripts/with-branch-schema.mjs --connection-limit=1 \"node --import tsx --test 'server/src/**/*.test.ts'\"",
    "test:e2e": "node scripts/with-branch-schema.mjs \"playwright test\"",
    "swarm": "cross-env NODE_OPTIONS=--max-old-space-size=8192 claude-flow swarm",
    "sparc": "cross-env NODE_OPTIONS=--max-old-space-size=8192 claude-flow sparc",
    "local": "node ./scripts/ollama-exec.cjs",
    "prisma:generate": "node scripts/with-branch-schema.mjs \"prisma generate\"",
    "prisma:migrate": "node scripts/with-branch-schema.mjs \"prisma migrate dev\"",
    "prisma:studio": "node scripts/with-branch-schema.mjs \"prisma studio\"",
    "db:setup": "node scripts/setup-local-db.mjs",
    "db:seed": "node scripts/with-branch-schema.mjs \"tsx server/scripts/seed-test-data.ts\"",
    "server:dev": "node scripts/with-branch-schema.mjs \"kill-port 4000 && tsx watch server/src/index.ts\"",
    "server:typecheck": "tsc -p server/tsconfig.json --noEmit",
    "docling:sidecar": "kill-port 8901 && \"server\\docling-sidecar\\.venv\\Scripts\\python.exe\" -m uvicorn service:app --host 127.0.0.1 --port 8901 --app-dir server/docling-sidecar"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@google/genai": "^2.17.1",
    "@prisma/client": "^6.16.3",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "konva": "^10.3.1",
    "lucide-react": "^1.32.0",
    "motion": "^13.1.1",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-konva": "^19.2.5",
    "react-router-dom": "^6.30.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "undici": "^6.28.0",
    "use-image": "^1.1.4",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.0.0",
    "kill-port": "^2.0.1",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.16.3",
    "ruflo": "^3.38.11",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0"
  }
}
